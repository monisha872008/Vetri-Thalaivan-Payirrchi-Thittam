# Copy this file to ".env" and fill in your values.

# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to run in demo mode (built-in smart fallback plans, no AI calls).
GEMINI_API_KEY=

# Primary model. If it is unavailable the app tries GEMINI_FALLBACK_MODELS in order.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-flash-latest

# Used to sign login tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

HOST=127.0.0.1
PORT=8000
